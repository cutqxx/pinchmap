		"builtin-modules": "^5.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"happy-dom": "^21.0.4",
		"monkey-around": "^3.0.0",
		"obsidian": "^1.14.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
