{
	"name": "pinchmap",
	"version": "0.1.6",
	"description": "Mind maps for Obsidian, touch and mouse first-class",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
